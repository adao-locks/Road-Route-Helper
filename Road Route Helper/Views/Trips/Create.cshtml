@{
    ViewData["Title"] = "Create Trip";
}



<div class="row">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-body">
                <h4>Create Trip</h4>
                <form id="tripForm">
                    <div class="mb-3">
                        <label class="form-label">Trip Name</label>
                        <input class="form-control" id="name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" id="description"></textarea>
                    </div>
                    <div class="row">
                        <div class="col">
                            <label class="form-label">Start Date</label>
                            <input type="date" class="form-control" id="startDate" />
                        </div>
                        <div class="col">
                            <label class="form-label">End Date</label>
                            <input type="date" class="form-control" id="endDate" />
                        </div>
                    </div>
                    <div class="mt-3 d-flex gap-2">
                        <button type="button" id="calcRouteBtn" data-testid="calc-route" class="btn btn-outline-primary">Calcular rota</button>
                        <button type="button" id="saveTripBtn" data-testid="save-trip" class="btn btn-primary">Salvar viagem</button>
                        <a class="btn btn-outline-secondary" href="/">Cancelar</a>
                    </div>
                    <div id="saveError" class="alert alert-danger mt-3 d-none" role="alert"></div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h5>Route Map</h5>
                <div id="map" style="height:480px"></div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-body">
                <h5>Stops</h5>
                <div class="d-flex gap-2 mb-2">
                    <input id="stopName" class="form-control form-control-sm" placeholder="Stop name" />
                    <button type="button" id="addStopBtn" class="btn btn-sm btn-success">Add</button>
                </div>
                <ul id="stopsList" class="list-group"></ul>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <h6>Generate</h6>
                <button class="btn btn-outline-primary" onclick="generateImage()">Generate Route Image</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // pass server routing url to external script
        window._tripCreate = { routingServiceUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["RoutingServiceUrl"])) };
    </script>
    <script src="/js/trip-create.js"></script>
}
