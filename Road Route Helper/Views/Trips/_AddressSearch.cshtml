<form id="addressSearch" class="mb-3">
    <div class="input-group input-group-sm">
        <input id="addressQuery" class="form-control" placeholder="Buscar endereço" aria-label="Buscar endereço" />
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
    </div>
    <div id="addressStatus" class="small text-muted mt-1" role="status"></div>
    <div id="addressResults" class="list-group mt-1"></div>
    <small class="text-muted">Busca por &copy; OpenStreetMap</small>
</form>
