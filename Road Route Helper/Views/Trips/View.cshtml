@model Road_Route_Helper.Domain.Trip
@{
    ViewData["Title"] = Model.Name;
}

    <div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@Model.Name</h2>
    <div>
        <a class="btn btn-outline-secondary" href="/">Back</a>
        <a class="btn btn-primary" href="/api/trips/@Model.Id/duplicate">Duplicate</a>
        <a class="btn btn-success" href="/Trips/View/@Model.Id/poster.svg" target="_blank">Generate Route Image</a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div id="mapView" style="height:560px" class="card mb-3"></div>
    </div>
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-body">
                <h5>Details</h5>
                <p>@Model.Description</p>
                <p><strong>Distance:</strong> @Model.TotalDistanceKm km</p>
                <p><strong>Duration:</strong> @Model.EstimatedDuration</p>
                <h6>Stops</h6>
                <ul>
                    @foreach(var s in Model.Stops)
                    {
                        <li>@s.Order - @s.Name (@s.Category)</li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const trip = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));
        const map = L.map('mapView').setView([trip.startingLatitude || 34.05, trip.startingLongitude || -118.24], 8);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);
        const latlngs = (trip.stops || []).map(s => [s.latitude, s.longitude]);
        for (const s of trip.stops || []) {
            L.marker([s.latitude, s.longitude]).addTo(map).bindPopup(s.name);
        }
        if (latlngs.length) {
            L.polyline(latlngs, { color: 'crimson' }).addTo(map);
            map.fitBounds(L.polyline(latlngs).getBounds(), { padding: [40,40] });
        }
    </script>
}
