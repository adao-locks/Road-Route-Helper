@model Road_Route_Helper.Domain.Trip
@{
    ViewData["Title"] = Model.Name;
}

    <div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@Model.Name</h2>
    <div>
        <a class="btn btn-outline-secondary" href="/">Voltar</a>
        <button type="button" id="duplicateTrip" class="btn btn-primary">Duplicar</button>
        <a class="btn btn-success" href="/Trips/View/@Model.Id/poster.svg" target="_blank">Gerar poster</a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div id="mapView" style="height:560px" class="card mb-3"></div>
    </div>
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-body">
                <h5>Detalhes</h5>
                <p>@Model.Description</p>
                @if (Model.StartDate != null || Model.EndDate != null)
                {
                    <p><strong>Período:</strong> @string.Join(" a ", new[] { Model.StartDate, Model.EndDate }.Where(d => d != null).Select(d => d!.Value.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture)))</p>
                }
                <p><strong>Distância:</strong> @Model.TotalDistanceKm.ToString("F1", new System.Globalization.CultureInfo("pt-BR")) km</p>
                <p><strong>Duração:</strong> @(Model.EstimatedDuration is { } duration ? Road_Route_Helper.Application.Formatting.DurationFormatter.Format(duration) : "")</p>
                <h6>Paradas</h6>
                <ol>
                    @foreach (var s in Model.Stops.OrderBy(s => s.Order))
                    {
                        <li>@s.Name (@Road_Route_Helper.Domain.StopCategoryStyles.For(s.Category).Label)</li>
                    }
                </ol>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("~/Views/Trips/_StopCategories.cshtml")
    <script type="application/json" id="trip-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Road_Route_Helper.Application.DTOs.TripMapper.ToDto(Model), new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)))</script>
    <script>
        const trip = JSON.parse(document.getElementById('trip-data').textContent);
        const stops = trip.stops;
        const routingServiceUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["RoutingServiceUrl"]));
        const map = L.map('mapView').setView([-14.2350, -51.9253], 4);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        document.getElementById('duplicateTrip').addEventListener('click', async () => {
            const response = await fetch(`/api/trips/${trip.id}/duplicate`, { method: 'POST' });
            if (response.ok) {
                const copy = await response.json();
                window.location.href = `/Trips/View/${copy.id}`;
            }
        });

        const addStopMarkers = () => stops.forEach(s =>
            L.marker([s.latitude, s.longitude], { icon: categoryIcon(s.category) }).addTo(map).bindPopup(textPopup(s.name)));

        if (trip.routeGeometry.length >= 2) {
            const line = L.polyline(trip.routeGeometry.map(p => [p.latitude, p.longitude]), { color: 'crimson', weight: 6 }).addTo(map);
            map.fitBounds(line.getBounds(), { padding: [40, 40] });
            addStopMarkers();
        } else if (stops.length >= 2) {
            L.Routing.control({
                waypoints: stops.map(s => L.latLng(s.latitude, s.longitude)),
                ...routingLocale(routingServiceUrl),
                lineOptions: { styles: [{ color: 'crimson', weight: 6 }] },
                showAlternatives: false,
                fitSelectedRoute: true,
                createMarker: (i, wp) => L.marker(wp.latLng, { icon: categoryIcon(stops[i].category) }).bindPopup(textPopup(stops[i].name))
            }).addTo(map);
        } else if (stops.length === 1) {
            addStopMarkers();
            map.setView([stops[0].latitude, stops[0].longitude], 12);
        }
    </script>
}
