@model Road_Route_Helper.Domain.Trip
@{
    ViewData["Title"] = Model.Name;
}

    <div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@Model.Name</h2>
    <div>
        <a class="btn btn-outline-secondary" href="/">Back</a>
        <a class="btn btn-primary" href="/api/trips/@Model.Id/duplicate">Duplicate</a>
        <a class="btn btn-success" href="/Trips/View/@Model.Id/poster.svg" target="_blank">Generate Route Image</a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div id="mapView" style="height:560px" class="card mb-3"></div>
    </div>
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-body">
                <h5>Details</h5>
                <p>@Model.Description</p>
                <p><strong>Distance:</strong> @Model.TotalDistanceKm km</p>
                <p><strong>Duration:</strong> @(Model.EstimatedDuration is { } duration ? Road_Route_Helper.Application.Formatting.DurationFormatter.Format(duration) : "")</p>
                <h6>Stops</h6>
                <ul>
                    @foreach(var s in Model.Stops)
                    {
                        <li>@s.Order - @s.Name (@s.Category)</li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="application/json" id="trip-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Road_Route_Helper.Application.DTOs.TripMapper.ToDto(Model), new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)))</script>
    <script>
        const trip = JSON.parse(document.getElementById('trip-data').textContent);
        const stops = trip.stops;
        const routingServiceUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["RoutingServiceUrl"]));
        const map = L.map('mapView').setView([trip.startingLatitude || 34.05, trip.startingLongitude || -118.24], 8);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);

        const addStopMarkers = () => stops.forEach(s =>
            L.marker([s.latitude, s.longitude]).addTo(map).bindPopup(textPopup(s.name)));

        if (trip.routeGeometry.length >= 2) {
            const line = L.polyline(trip.routeGeometry.map(p => [p.latitude, p.longitude]), { color: 'crimson', weight: 6 }).addTo(map);
            map.fitBounds(line.getBounds(), { padding: [40, 40] });
            addStopMarkers();
        } else if (stops.length >= 2) {
            L.Routing.control({
                waypoints: stops.map(s => L.latLng(s.latitude, s.longitude)),
                router: L.Routing.osrmv1({ serviceUrl: routingServiceUrl }),
                lineOptions: { styles: [{ color: 'crimson', weight: 6 }] },
                showAlternatives: false,
                fitSelectedRoute: true,
                createMarker: (i, wp) => L.marker(wp.latLng).bindPopup(textPopup(stops[i].name))
            }).addTo(map);
        } else if (stops.length === 1) {
            addStopMarkers();
            map.setView([stops[0].latitude, stops[0].longitude], 12);
        }
    </script>
}
