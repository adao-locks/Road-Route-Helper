@model Road_Route_Helper.Domain.Trip
@{
    ViewData["Title"] = "Edit Trip";
}

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-body">
                <h4>Editar Viagem</h4>
                <form id="tripForm">
                    <div class="mb-3">
                        <label class="form-label">Trip Name</label>
                        <input class="form-control" id="name" value="@Model.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" id="description">@Model.Description</textarea>
                    </div>
                    <div class="row">
                        <div class="col">
                            <label class="form-label">Start Date</label>
                            <input type="date" class="form-control" id="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col">
                            <label class="form-label">End Date</label>
                            <input type="date" class="form-control" id="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                    </div>
                    <div class="mt-3 d-flex gap-2">
                        <button type="button" id="calcRouteBtn" data-testid="calc-route" class="btn btn-outline-primary">Calcular rota</button>
                        <button type="button" id="saveTripBtn" data-testid="save-trip" class="btn btn-primary">Salvar alterações</button>
                        <a class="btn btn-outline-secondary" href="/">Cancelar</a>
                    </div>
                    <div id="saveError" class="alert alert-danger mt-3 d-none" role="alert"></div>
                    <div id="routeStatus" class="alert alert-warning mt-3 d-none" role="status"></div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h5>Route Map</h5>
                <div id="map" style="height:480px"></div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-body">
                <h5>Stops</h5>
                <p class="text-muted small mb-2">Clique no mapa para adicionar uma parada.</p>
                <ul id="stopsList" class="list-group"></ul>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <h6>Generate</h6>
                <a class="btn btn-outline-primary" href="/Trips/View/@Model.Id/poster.svg" target="_blank">Generate Route Image</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("~/Views/Trips/_StopCategories.cshtml")
    <script type="application/json" id="trip-initial-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Road_Route_Helper.Application.DTOs.TripMapper.ToDto(Model), new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)))</script>
    <script>
        window._tripCreate = { routingServiceUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["RoutingServiceUrl"])) };
    </script>
    <script src="/js/trip-create.js"></script>
}
