@{
    ViewData["Title"] = "Painel";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Painel</h1>
    <a class="btn btn-primary" href="/Trips/Create">+ Nova viagem</a>
</div>

<div id="trips" class="row gy-3"></div>

<template id="tripCard">
    <div class="col-12 col-md-6 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title" data-field="name"></h5>
                <p class="card-text text-truncate" data-field="description"></p>
                <p class="mb-1"><small data-field="dates"></small></p>
                <div class="d-flex gap-2">
                    <a class="btn btn-sm btn-outline-primary" data-action="edit">Editar</a>
                    <a class="btn btn-sm btn-outline-secondary" data-action="open">Abrir</a>
                    <button type="button" class="btn btn-sm btn-outline-danger" data-action="delete">Excluir</button>
                </div>
            </div>
        </div>
    </div>
</template>

@section Scripts {
    <script>
        function formatDates(trip) {
            return [trip.startDate, trip.endDate].filter(Boolean).map(formatDate).join(' a ');
        }

        async function loadTrips() {
            const response = await fetch('/api/trips');
            const trips = await response.json();
            const template = document.getElementById('tripCard');
            const cards = trips.map(trip => {
                const card = template.content.cloneNode(true);
                card.querySelector('[data-field=name]').textContent = trip.name;
                card.querySelector('[data-field=description]').textContent = trip.description || '';
                card.querySelector('[data-field=dates]').textContent = formatDates(trip);
                card.querySelector('[data-action=edit]').href = `/Trips/Edit/${trip.id}`;
                card.querySelector('[data-action=open]').href = `/Trips/View/${trip.id}`;
                card.querySelector('[data-action=delete]').addEventListener('click', () => deleteTrip(trip.id));
                return card;
            });
            document.getElementById('trips').replaceChildren(...cards);
        }

        async function deleteTrip(id) {
            if (!confirm('Excluir esta viagem?')) return;
            await fetch('/api/trips/' + id, { method: 'DELETE' });
            loadTrips();
        }

        loadTrips();
    </script>
}
